    "@sanity/vision": "^6.22.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.0.10",
    "axios": "^1.11.0",
    "date-fns-tz": "^2.0.1",
    "gsap": "^3.12.5",
    "lightgallery": "^2.7.2",
    "lottie-web": "^5.13.0",
    "next": "^16.4.5",
