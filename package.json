  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "INFISICAL_TOKEN=$INFISICAL_LUMITRA_TOKEN infisical run --env=dev --projectId=$INFISICAL_PID_PARKBAD -- next dev",
    "dev:local": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
